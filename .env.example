# This file is a reference. Flask does not load .env files automatically.
# Render receives these values from render.yaml; never put a real secret here.
SELLER_MVP_DEMO_MODE=true
SELLER_MVP_SECRET=
SELLER_MVP_DEMO_DATA_DIR=./tmp/seller-profit-assistant-demo
SELLER_MVP_DEMO_SESSION_TTL_HOURS=6
SELLER_MVP_DEMO_MAX_SESSIONS=50
SELLER_MVP_COOKIE_SECURE=true
SELLER_MVP_MAX_UPLOAD_MB=5
SELLER_MVP_MAX_ROWS=5000
